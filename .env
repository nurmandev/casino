
# =================================================================
# BETTHROB FRONTEND ENVIRONMENT CONFIGURATION
# =================================================================
# Copy this file to betthrob-app/.env and fill in your actual values

# =================================================================
# API CONFIGURATION
# =================================================================
# tion
VITE_DEBUG=true

# =================================================================
# ASSET URLs
# =================================================================
# CDN URL for assets (optional)
VITE_ASSETS_URL=https://cdn.yourdomain.com

# Logo URL
VITE_LOGO_URL=/logo.svg

# =================================================================
# FEATURE FLAGS
# =================================================================
# Enable/disable specific features
VITE_ENABLE_SPORTS_BETTING=true
VITE_ENABLE_CASINO=true
VITE_ENABLE_AFFILIATE=true
VITE_ENABLE_VIP=true

# =================================================================
# SECURITY
# =================================================================
# Content Security Policy (CSP) settings
VITE_CSP_REPORT_URI=https://yourdomain.com/csp-report

# =================================================================
# EXAMPLE PRODUCTION VALUES
# =================================================================
# VITE_API_BASE_URL=https://api.yourdomain.com/api
# VITE_SOCKET_URL=https://api.yourdomain.com
# VITE_GA_TRACKING_ID=G-REAL123456789
# VITE_SENTRY_DSN=https://real-key@sentry.io/123456
# VITE_DEV_MODE=false
# VITE_DEBUG=false
