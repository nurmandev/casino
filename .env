HOST_API_KEY=https://bethrob-admin-new.onrender.com/
VITE_HOST_API=https://bethrob-admin-new.onrender.com/
VITE_LOCAL_HOST_AP=https://bethrob-admin-new.onrender.com/


# =================================================================
# BETTHROB FRONTEND ENVIRONMENT CONFIGURATION
# =================================================================
# Copy this file to betthrob-app/.env and fill in your actual values

# =================================================================
# API CONFIGURATION
# =================================================================
# Backend API base URL
VITE_API_BASE_URL=https://bethrob-admin-new.onrender.com/

# WebSocket URL for real-time features
VITE_SOCKET_URL=https://bethrob-admin-new.onrender.com/

# =================================================================
# APPLICATION SETTINGS
# =================================================================
# Application name
VITE_APP_NAME="87 Casino"
# Application version
VITE_APP_VERSION=1.0.0

# =================================================================
# EXTERNAL SERVICES
# =================================================================
# Google Analytics tracking ID (optional)
VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Sentry DSN for error tracking (optional)
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# =================================================================
# DEVELOPMENT SETTINGS
# =================================================================
# Enable development features
VITE_DEV_MODE=true

# Show debug information
VITE_DEBUG=true

# =================================================================
# ASSET URLs
# =================================================================
# CDN URL for assets (optional)
VITE_ASSETS_URL=https://cdn.yourdomain.com

# Logo URL
VITE_LOGO_URL=/logo.svg

# =================================================================
# FEATURE FLAGS
# =================================================================
# Enable/disable specific features
VITE_ENABLE_SPORTS_BETTING=true
VITE_ENABLE_CASINO=true
VITE_ENABLE_AFFILIATE=true
VITE_ENABLE_VIP=true

# =================================================================
# SECURITY
# =================================================================
# Content Security Policy (CSP) settings
VITE_CSP_REPORT_URI=https://yourdomain.com/csp-report

# =================================================================
# EXAMPLE PRODUCTION VALUES
# =================================================================
# VITE_API_BASE_URL=https://api.yourdomain.com/api
# VITE_SOCKET_URL=https://api.yourdomain.com
# VITE_GA_TRACKING_ID=G-REAL123456789
# VITE_SENTRY_DSN=https://real-key@sentry.io/123456
# VITE_DEV_MODE=false
# VITE_DEBUG=false